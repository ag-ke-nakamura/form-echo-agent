# Claude Code local-only state (per-user MCP/tool trust approvals, machine-specific overrides)
.claude/settings.local.json

# Node / npm / pnpm / yarn — safety net for any tooling added anywhere in this workspace
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
dist/
build/
# next dev は turbopack の root をワークスペースルート（pnpm-workspace.yaml のある場所）と
# 推論し、ここに .next/ を作る。next.config.ts で root を nextjs-app に固定すると直るように
# 見えるが、pnpm は next の実体をルートの node_modules/.pnpm に置くので
# "Could not find the Next.js package" で dev が起動しなくなる。推論のままにして無視する
.next/
coverage/
*.tsbuildinfo

# Secrets / local env overrides
.env
.env.local
.env.*.local

# Logs / caches
*.log
.cache/

# OS cruft
.DS_Store

# Editor
.vscode/
.idea/

temp/
# Python (Claude Code フックスクリプト)
__pycache__/

# 個人用のプロジェクト限定メモリ
CLAUDE.local.md
