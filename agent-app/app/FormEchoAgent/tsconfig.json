{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": ["node"],
    "paths": {
      "zod": ["./node_modules/zod"]
    }
  },
  "include": ["**/*.ts"],
  // テストは emit の対象外。`dist/` に入れると `agentcore deploy` が運ぶ成果物に
  // テストランナー依存のファイルが乗る。型検査は tsconfig.test.json が見る。
  // `model/fake.ts` は除かない — 設定で選ぶ差し替えなので Runtime 側の実装であり、
  // `model/load.ts` が静的に import している。
  "exclude": ["node_modules", "dist", "tests", "**/*.test.ts"]
}
