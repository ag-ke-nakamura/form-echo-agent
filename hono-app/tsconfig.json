{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "paths": {
      "@contracts/*": ["../contracts/*"],
      "zod": ["./node_modules/zod"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "vitest.config.mts"]
}
