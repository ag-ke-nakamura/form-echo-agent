{
  "permissions": {
    "allow": [
      "Bash(git grep *)",
      "Bash(git fetch *)",
      "Bash(aws sts get-caller-identity)",
      "Bash(git ls-tree *)",
      "Bash(git merge-base *)",
      "Bash(npm audit)",
      "Bash(git merge-tree *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Bash(git push --force:*)",
      "Bash(git push * --force)",
      "Bash(git push -f:*)",
      "Bash(git push * -f)",
      "Bash(aws * delete-*)",
      "Bash(aws * remove-*)",
      "Bash(aws s3 rb:*)",
      "Bash(aws s3 rm:*)",
      "Bash(cdk destroy:*)",
      "Bash(npx cdk destroy:*)",
      "Bash(terraform destroy:*)",
      "Bash(pulumi destroy:*)",
      "Bash(kubectl delete:*)",
      "Bash(helm uninstall:*)",
      "Bash(helm delete:*)"
    ],
    "ask": [
      "Bash(agentcore deploy:*)",
      "Bash(cdk deploy:*)",
      "Bash(npx cdk deploy:*)",
      "Bash(npm run cdk:*)",
      "Bash(git push:*)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/guard-destructive-command.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "aws-core@agent-toolkit-for-aws": true,
    "hono-skill@hono-skill": true,
    "commit-commands@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "mattpocock-skills@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "ponytail@claude-community": true
  }
}
